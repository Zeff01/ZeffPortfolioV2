# EmailJS Configuration
# Sign up at https://www.emailjs.com/ to get your credentials
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# J.A.R.V.I.S. neural voice (server-side only — never prefix with NEXT_PUBLIC_)
# Set ONE of these. ElevenLabs is preferred when both are present.
# Without either, Jarvis falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=
# Optional: any voice from your ElevenLabs Voice Library (default: "Daniel", British).
# e.g. wDsJlOXPqcvIUKdLXjDs = "Jarvis" (needs Creator plan; falls back to Daniel otherwise)
ELEVENLABS_VOICE_ID=
# Optional: defaults to eleven_multilingual_v2
ELEVENLABS_MODEL_ID=
OPENAI_API_KEY=
# Optional: defaults to fable
OPENAI_TTS_VOICE=

# Optional: max parallel TTS requests to the provider (ElevenLabs Starter allows 2)
JARVIS_TTS_CONCURRENCY=

# J.A.R.V.I.S. AI brain (server-side only). Without it Jarvis uses the local keyword brain.
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5 (e.g. claude-haiku-5-5 for lower cost/latency)
JARVIS_MODEL=
# Optional: low | medium | high (default low — replies are short and spoken)
JARVIS_EFFORT=

# "Email me his profile" (optional). EmailJS template that emails the VISITOR:
# set its "To Email" to {{to_email}} and use {{summary}}, {{resume_url}},
# {{portfolio_url}}, {{contact_email}} in the body. Without it, Jarvis only
# notifies you (via the contact template above) and says you'll follow up.
NEXT_PUBLIC_EMAILJS_PROFILE_TEMPLATE_ID=

# Anonymous log of what visitors ask Jarvis (optional). Always written to the
# server logs as [jarvis-question]; set a Discord/Slack incoming webhook (or any
# URL that accepts JSON) to also get each question there.
JARVIS_LOG_WEBHOOK=

# Optional: model for the AI résumé writer (defaults to JARVIS_MODEL)
RESUME_MODEL=
